# Vercel / Next.js: copiar los valores desde el entorno local, sin renombrar.
# La URL y el JWT anon son publicos: /api/public los entrega al navegador.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Origen exacto sin barra final. En Production usar el dominio de produccion.
# En Preview puede omitirse: la API usa el origen de la peticion.
APP_ORIGIN=

# Solo Supabase Edge (no agregar a Vercel ni al navegador):
# SUPABASE_SERVICE_ROLE_KEY: inyectada automaticamente por Supabase.
# IP_HASH_SECRET: opcional; si falta, Edge usa su service role para el HMAC.
