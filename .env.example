SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Supabase Edge only; never NEXT_PUBLIC_ or VITE_:
# SUPABASE_SERVICE_ROLE_KEY is injected by Supabase
# IP_HASH_SECRET=generate-a-random-32-byte-secret
# Edge falls back to a domain-separated HMAC of its injected service key.
APP_ORIGIN=http://localhost:5173
